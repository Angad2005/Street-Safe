{
  "name": "streetsafe",
  "version": "1.0.0",
  "scripts": {
    "android": "expo start --android",
    "ios": "expo start --ios",
    "start": "expo start",
    "start:streetsafe": "cross-env EXPO_PUBLIC_API_URL=https://streetsafe.828101.xyz expo start",
    "start:dev": "cross-env EXPO_PUBLIC_API_URL=http://localhost:8080 expo start",
    "prebuild": "expo prebuild",
    "web": "expo start --web",
    "test": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/orbitron": "^0.4.2",
    "@expo-google-fonts/rajdhani": "^0.4.1",
    "@gedeagas/react-universal-websocket": "^1.1.6",
    "@types/react-test-renderer": "^19.1.0",
    "expo": "^54.0.33",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.10",
    "nativewind": "latest",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-use-websocket": "^4.13.0",
    "socket.io-client": "^4.8.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@types/react-test-renderer": "^19.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.2",
    "jest": "^29.7.0",
    "jest-expo": "^47.0.1",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-test-renderer": "^19.1.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.1.2",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "react-native",
    "setupFiles": [
      "./jest.early.setup.js"
    ],
    "moduleNameMapper": {
      "^components/(.*)$": "<rootDir>/components/$1",
      "^lib/(.*)$": "<rootDir>/lib/$1",
      "^utils/(.*)$": "<rootDir>/utils/$1",
      "^app/(.*)$": "<rootDir>/app/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ]
  },
  "main": "expo-router/entry",
  "private": true
}
